{
  "log": {
    "level": "info"
  },
  "storage": {
    "rootDirectory": "/tmp/zot-b2",
    "remoteCache": true,
    "redirectBlobURL": true,
    "fastRestart": true,
    "storageDriver": {
      "name": "s3",
      "region": "eu-central-003",
      "regionendpoint": "s3.eu-central-003.backblazeb2.com",
      "bucket": "sophons",
      "rootdirectory": "/zenlesszonezot",
      "forcepathstyle": true,
      "accesskey": "${B2_ACCESS_KEY_ID}",
      "secretkey": "${B2_SECRET_ACCESS_KEY}"
    },
    "cacheDriver": {
      "name": "redis",
      "addr": [
        "valkeyrie-redis-ha.alpha-centauri-system:26379"
      ],
      "master_name": "valkeyrie",
      "keyprefix": "z3:k"
    },
    "retention": {
      "dryRun": false,
      "delay": "24h",
      "policies": [
        {
          "repositories": [
            "/mirror/**"
          ],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepTags": [
            {
              "pulledWithin": "720h",
              "pushedWithin": "720h"
            }
          ],
          "keepUntagged": {
            "pulledWithin": "720h",
            "pushedWithin": "720h"
          }
        },
        {
          "keepTags": [
            {
              "patterns": [
                ".*"
              ]
            }
          ]
        }
      ]
    },
    "subPaths": {
      "/p": {
        "rootDirectory": "/tmp/zot-garage",
        "remoteCache": true,
        "redirectBlobURL": true,
        "storageDriver": {
          "name": "s3",
          "region": "global",
          "regionendpoint": "ps3-global.sphns.run",
          "redirectendpoint": "s3-global.sphns.run",
          "bucket": "zenlesszonezot",
          "forcepathstyle": true,
          "accesskey": "${GARAGE_ACCESS_KEY_ID}",
          "secretkey": "${GARAGE_SECRET_ACCESS_KEY}"
        },
        "cacheDriver": {
          "name": "redis",
          "addr": [
            "valkeyrie-redis-ha.alpha-centauri-system:26379"
          ],
          "master_name": "valkeyrie",
          "keyprefix": "z3:k"
        }
      }
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "readTimeout": "0",
    "writeTimeout": "0",
    "compat": [
      "docker2s2"
    ],
    "externalUrl": "https://zenlesszonezot.sophons.cloud",
    "auth": {
      "apikey": true,
      "sessionDriver": {
        "name": "redis",
        "addr": [
          "valkeyrie-redis-ha.alpha-centauri-system:26379"
        ],
        "master_name": "valkeyrie",
        "keyprefix": "z3:s"
      },
      "htpasswd": {
        "path": "/secrets/z3/htpasswd"
      },
      "openid": {
        "providers": {
          "oidc": {
            "credentialsFile": "/secrets/z3/oidc.json",
            "issuer": "https://auth.sophons.cloud",
            "scopes": [
              "openid",
              "profile",
              "email",
              "groups"
            ],
            "claimMapping": {
              "username": "preferred_username",
              "groups": "groups"
            }
          }
        }
      }
    },
    "accessControl": {
      "metrics": {
        "anonymousPolicy": [
          "read"
        ]
      },
      "groups": {
        "readers": {
          "users": [
            "push",
            "kluzter"
          ]
        },
        "writers": {
          "users": [
            "push"
          ]
        }
      },
      "repositories": {
        "**": {
          "policies": [
            {
              "groups": [
                "readers"
              ],
              "actions": [
                "read"
              ]
            },
            {
              "groups": [
                "writers"
              ],
              "actions": [
                "create",
                "update"
              ]
            }
          ]
        },
        "cloudflare/workerd": {
          "policies": [
            {
              "groups": [
                "readers"
              ],
              "actions": [
                "read"
              ]
            },
            {
              "groups": [
                "woodpecker:repo:1",
                "writers"
              ],
              "actions": [
                "read",
                "create",
                "update"
              ]
            }
          ]
        },
        "library/**": {
          "policies": [
            {
              "groups": [
                "writers"
              ],
              "actions": [
                "create",
                "update"
              ]
            }
          ],
          "anonymousPolicy": [
            "read"
          ],
          "defaultPolicy": [
            "read"
          ]
        }
      },
      "adminPolicy": {
        "groups": [
          "admins"
        ],
        "actions": [
          "read",
          "create",
          "update",
          "delete"
        ]
      }
    }
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "credentialsFile": "/secrets/z3/sync-auth.json",
      "DownloadDir": "/tmp/zot/sync",
      "registries": [
        {
          "urls": [
            "https://ghcr.io"
          ],
          "content": [
            {
              "prefix": "/browserless/chromium",
              "tags": {
                "excludeRegex": ".*"
              },
              "destination": "/mirror/ghcr.io"
            },
            {
              "prefix": "/immich-app/immich-machine-learning",
              "tags": {
                "excludeRegex": ".*-rocm$"
              },
              "destination": "/mirror/ghcr.io"
            },
            {
              "prefix": "**",
              "destination": "/mirror/ghcr.io"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        },
        {
          "urls": [
            "https://dhi.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/mirror/dhi.io"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        },
        {
          "urls": [
            "https://registry-1.docker.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/mirror/docker.io"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        },
        {
          "urls": [
            "https://quay.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/mirror/quay.io"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        },
        {
          "urls": [
            "https://registry.k8s.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/mirror/registry.k8s.io"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        },
        {
          "urls": [
            "https://gcr.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/mirror/gcr.io"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        },
        {
          "urls": [
            "https://public.ecr.aws"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/mirror/public.ecr.aws"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        },
        {
          "urls": [
            "https://code.forgejo.org"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/mirror/code.forgejo.org"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        },
        {
          "urls": [
            "https://codeberg.org"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/mirror/codeberg.org"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        }
      ]
    },
    "metrics": {
      "enable": true,
      "prometheus": {
        "path": "/metrics"
      }
    }
  }
}
