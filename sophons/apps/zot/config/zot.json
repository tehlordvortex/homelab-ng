{
  "log": {
    "level": "debug"
  },
  "storage": {
    "rootDirectory": "/tmp/zot",
    "remoteCache": true,
    "redirectBlobURL": true,
    "fastRestart": true,
    "storageDriver": {
      "name": "s3",
      "region": "global",
      "bucket": "zenlesszonezot",
      "secure": false,
      "forcepathstyle": true,
      "regionendpoint": "s3-global.sphns.run",
      "loglevel": "debug"
    },
    "cacheDriver": {
      "name": "redis",
      "master_name": "myMaster",
      "addr": [
        "redis-z3-sentinel:26379"
      ],
      "keyprefix": "z3"
    },
    "retention": {
      "dryRun": false,
      "delay": "24h",
      "policies": [
        {
          "repositories": [
            "/proxy-*/**"
          ],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepTags": [
            {
              "pulledWithin": "720h",
              "pushedWithin": "720h"
            }
          ]
        },
        {
          "keepTags": [
            {
              "patterns": [
                ".*"
              ]
            }
          ]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "readTimeout": "0",
    "writeTimeout": "0",
    "compat": [
      "docker2s2"
    ],
    "externalUrl": "https://zenlesszonezot.sophons.cloud",
    "auth": {
      "apikey": true,
      "sessionKeysFile": "/secrets/z3/session.json",
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      },
      "openid": {
        "providers": {
          "oidc": {
            "credentialsFile": "/secrets/z3/oidc.json",
            "issuer": "https://auth.sophons.cloud",
            "scopes": [
              "openid",
              "profile",
              "email",
              "groups"
            ],
            "claimMapping": {
              "username": "preferred_username",
              "groups": "groups"
            }
          }
        }
      }
    },
    "accessControl": {
      "metrics": {
        "anonymousPolicy": [
          "read"
        ]
      },
      "repositories": {
        "**": {
          "policies": [
            {
              "users": [
                "kluzter"
              ],
              "actions": [
                "read"
              ]
            }
          ],
          "defaultPolicy": []
        },
        "library/**": {
          "anonymousPolicy": [
            "read"
          ],
          "defaultPolicy": [
            "read"
          ]
        }
      },
      "adminPolicy": {
        "groups": [
          "admins"
        ],
        "actions": [
          "read",
          "create",
          "update",
          "delete"
        ]
      }
    }
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "credentialsFile": "/secrets/z3/sync-auth.json",
      "DownloadDir": "/tmp/zot/sync",
      "registries": [
        {
          "urls": [
            "https://ghcr.io"
          ],
          "content": [
            {
              "prefix": "/browserless/chromium",
              "tags": {
                "excludeRegex": ".*"
              },
              "destination": "/proxy-ghcr.io"
            },
            {
              "prefix": "/immich-app/immich-machine-learning",
              "tags": {
                "excludeRegex": ".*-rocm$"
              },
              "destination": "/proxy-ghcr.io"
            },
            {
              "prefix": "**",
              "destination": "/proxy-ghcr.io"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        },
        {
          "urls": [
            "https://index.docker.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/proxy-docker.io"
            }
          ],
          "onDemand": true,
          "preserveDigest": true
        }
      ]
    },
    "metrics": {
      "enable": true,
      "prometheus": {
        "path": "/metrics"
      }
    }
  }
}
